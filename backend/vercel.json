{
  "version": 2,
  "builds": [
    {
      "src": "api/index.ts",
      "use": "@vercel/node",
      "config": {
        "maxDuration": 30
      }
    }
  ],
  "routes": [
    {
      "src": "/(.*)",
      "dest": "api/index.ts"
    }
  ],
  "crons": [
    {
      "path": "/ping",
      "schedule": "*/5 * * * *"
    },
    {
      "path": "/gps/sync",
      "schedule": "0 3 * * *"
    }
  ]
}
